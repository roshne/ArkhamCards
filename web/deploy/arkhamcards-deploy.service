# arkhamcards auto-deploy -- oneshot service that runs deploy-pull.sh once per image (api, then web):
# pull it and recreate that container when the running one isn't on it. From
# rackbops-web-deploy-template (servers/node-app/publish/deploy-pull.service.example).
#
# Install as /etc/systemd/system/arkhamcards-deploy.service, with the paired .timer. A system unit
# that drops to the stack's user, who must be in the `docker` group (root-equivalent). The two
# ExecStart lines run in order; if the first fails the unit fails and the timer retries next cycle.
# Type=oneshot has no start timeout by default, so TimeoutStartSec bounds a hung pull.
[Unit]
Description=arkhamcards -- pull the latest images and recreate on a new digest
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
TimeoutStartSec=6min
User=roshne
ExecStart=/usr/bin/env SERVICE=api /bin/bash /opt/stacks/arkhamcards/deploy/deploy-pull.sh
ExecStart=/usr/bin/env SERVICE=web /bin/bash /opt/stacks/arkhamcards/deploy/deploy-pull.sh
